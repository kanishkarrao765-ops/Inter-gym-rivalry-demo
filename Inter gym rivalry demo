<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>INTER RIVALRY — Pitch Demo</title>
    <style>
        /* ============================================
           DARK FUTURISTIC THEME
           ============================================ */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
            background: #0b0d14;
            color: #e8edf5;
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 20px;
        }

        /* --- App Container --- */
        .app {
            max-width: 420px;
            width: 100%;
            background: linear-gradient(145deg, #11141e, #0a0c12);
            border-radius: 32px;
            padding: 24px 20px 32px;
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.9), 0 0 0 1px rgba(255, 215, 0, 0.06);
            position: relative;
            overflow: hidden;
        }

        .app::before {
            content: '';
            position: absolute;
            top: -50%;
            left: -50%;
            width: 200%;
            height: 200%;
            background: radial-gradient(circle at 30% 20%, rgba(255, 215, 0, 0.02), transparent 60%);
            pointer-events: none;
        }

        /* --- Glow Accent --- */
        .glow-gold {
            color: #f5c842;
            text-shadow: 0 0 20px rgba(245, 200, 66, 0.15);
        }

        .glow-cyan {
            color: #5fc8ff;
            text-shadow: 0 0 20px rgba(95, 200, 255, 0.12);
        }

        /* --- Top Bar --- */
        .top-bar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 20px;
            position: relative;
            z-index: 2;
        }

        .logo {
            font-weight: 800;
            font-size: 20px;
            letter-spacing: -0.5px;
        }
        .logo span {
            color: #f5c842;
        }

        .gym-badge {
            background: rgba(245, 200, 66, 0.08);
            border: 1px solid rgba(245, 200, 66, 0.15);
            border-radius: 100px;
            padding: 4px 14px;
            font-size: 11px;
            font-weight: 600;
            letter-spacing: 0.3px;
            color: #f5c842;
        }

        /* --- Screens --- */
        .screen {
            display: none;
            animation: fadeUp 0.3s ease;
            position: relative;
            z-index: 2;
        }

        .screen.active {
            display: block;
        }

        @keyframes fadeUp {
            0% { opacity: 0; transform: translateY(12px); }
            100% { opacity: 1; transform: translateY(0); }
        }

        /* --- Login --- */
        .login-box {
            text-align: center;
            padding: 30px 0 10px;
        }

        .login-box h1 {
            font-size: 28px;
            font-weight: 800;
            margin-bottom: 6px;
        }

        .login-box p {
            color: #8b93a8;
            font-size: 14px;
            margin-bottom: 28px;
        }

        .login-btn {
            background: linear-gradient(135deg, #f5c842, #dba62e);
            border: none;
            color: #0b0d14;
            font-weight: 700;
            font-size: 16px;
            padding: 14px 40px;
            border-radius: 100px;
            cursor: pointer;
            transition: all 0.2s;
            width: 100%;
            max-width: 220px;
            box-shadow: 0 8px 30px rgba(245, 200, 66, 0.15);
        }

        .login-btn:hover {
            transform: scale(1.02);
            box-shadow: 0 12px 40px rgba(245, 200, 66, 0.25);
        }

        .login-btn:active {
            transform: scale(0.97);
        }

        /* --- Navigation --- */
        .nav {
            display: flex;
            gap: 4px;
            background: rgba(255, 255, 255, 0.03);
            border-radius: 100px;
            padding: 4px;
            margin-top: 20px;
            border: 1px solid rgba(255, 255, 255, 0.04);
        }

        .nav button {
            flex: 1;
            background: transparent;
            border: none;
            color: #6c758f;
            font-size: 12px;
            font-weight: 600;
            padding: 10px 0;
            border-radius: 100px;
            cursor: pointer;
            transition: all 0.2s;
            letter-spacing: 0.2px;
        }

        .nav button.active {
            background: rgba(245, 200, 66, 0.08);
            color: #f5c842;
            box-shadow: 0 0 0 1px rgba(245, 200, 66, 0.05);
        }

        .nav button:hover {
            color: #e8edf5;
        }

        /* --- Cards --- */
        .stat-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 10px;
            margin: 16px 0;
        }

        .stat-card {
            background: rgba(255, 255, 255, 0.02);
            border-radius: 16px;
            padding: 14px 12px;
            border: 1px solid rgba(255, 255, 255, 0.04);
        }

        .stat-card .label {
            font-size: 10px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            color: #6c758f;
        }

        .stat-card .value {
            font-size: 22px;
            font-weight: 700;
            margin-top: 2px;
        }

        .stat-card .value small {
            font-size: 13px;
            font-weight: 400;
            color: #6c758f;
        }

        /* --- Profile --- */
        .profile-header {
            display: flex;
            align-items: center;
            gap: 16px;
            margin: 16px 0 20px;
        }

        .avatar {
            width: 64px;
            height: 64px;
            border-radius: 50%;
            background: linear-gradient(135deg, #f5c842, #dba62e);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 28px;
            font-weight: 700;
            color: #0b0d14;
            flex-shrink: 0;
        }

        .profile-info h3 {
            font-size: 18px;
            font-weight: 700;
        }

        .profile-info .id {
            font-size: 12px;
            color: #6c758f;
            font-family: monospace;
            letter-spacing: 0.5px;
        }

        .profile-info .rank-badge {
            display: inline-block;
            background: rgba(245, 200, 66, 0.12);
            padding: 2px 14px;
            border-radius: 100px;
            font-size: 13px;
            font-weight: 700;
            color: #f5c842;
            margin-top: 4px;
        }

        /* --- List Items --- */
        .list-item {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 14px 0;
            border-bottom: 1px solid rgba(255, 255, 255, 0.04);
        }

        .list-item:last-child {
            border-bottom: none;
        }

        .list-item .primary {
            font-weight: 600;
            font-size: 15px;
        }

        .list-item .secondary {
            font-size: 13px;
            color: #8b93a8;
        }

        .list-item .right {
            text-align: right;
        }

        .tag {
            display: inline-block;
            padding: 2px 12px;
            border-radius: 100px;
            font-size: 11px;
            font-weight: 600;
        }

        .tag.gold {
            background: rgba(245, 200, 66, 0.12);
            color: #f5c842;
        }

        .tag.cyan {
            background: rgba(95, 200, 255, 0.08);
            color: #5fc8ff;
        }

        .tag.green {
            background: rgba(0, 230, 118, 0.08);
            color: #00e676;
        }

        .tag.pending {
            background: rgba(255, 165, 0, 0.08);
            color: #ffa500;
        }

        /* --- Challenge Card --- */
        .challenge-card {
            background: rgba(255, 255, 255, 0.02);
            border-radius: 16px;
            padding: 16px;
            margin-top: 12px;
            border: 1px solid rgba(255, 255, 255, 0.04);
        }

        .challenge-card .vs {
            display: flex;
            justify-content: space-between;
            align-items: center;
            font-weight: 700;
            font-size: 16px;
        }

        .challenge-card .vs .vs-text {
            color: #f5c842;
            font-size: 14px;
        }

        .challenge-card .detail {
            font-size: 13px;
            color: #8b93a8;
            margin-top: 6px;
        }

        .challenge-card .progress {
            margin-top: 10px;
            height: 4px;
            background: rgba(255, 255, 255, 0.06);
            border-radius: 100px;
            overflow: hidden;
        }

        .challenge-card .progress .fill {
            height: 100%;
            width: 60%;
            background: linear-gradient(90deg, #f5c842, #dba62e);
            border-radius: 100px;
        }

        /* --- Leaderboard --- */
        .lb-item {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 12px 0;
            border-bottom: 1px solid rgba(255, 255, 255, 0.03);
        }

        .lb-item .pos {
            font-weight: 700;
            color: #6c758f;
            width: 24px;
            font-size: 14px;
        }

        .lb-item .name {
            flex: 1;
            font-weight: 600;
        }

        .lb-item .rank {
            font-weight: 700;
            color: #f5c842;
            font-size: 14px;
        }

        .lb-item .xp {
            font-size: 13px;
            color: #8b93a8;
        }

        /* --- Search --- */
        .search {
            background: rgba(255, 255, 255, 0.04);
            border: 1px solid rgba(255, 255, 255, 0.06);
            border-radius: 100px;
            padding: 10px 16px;
            width: 100%;
            color: #e8edf5;
            font-size: 14px;
            outline: none;
            margin: 12px 0 6px;
        }

        .search::placeholder {
            color: #6c758f;
        }

        .search:focus {
            border-color: rgba(245, 200, 66, 0.2);
        }

        /* --- Action Buttons --- */
        .action-btn {
            background: rgba(245, 200, 66, 0.06);
            border: 1px solid rgba(245, 200, 66, 0.1);
            color: #f5c842;
            padding: 8px 18px;
            border-radius: 100px;
            font-weight: 600;
            font-size: 13px;
            cursor: pointer;
            transition: all 0.2s;
            width: 100%;
            margin-top: 8px;
        }

        .action-btn:hover {
            background: rgba(245, 200, 66, 0.12);
        }

        .action-btn.primary {
            background: #f5c842;
            color: #0b0d14;
            border: none;
        }

        .action-btn.primary:hover {
            background: #dba62e;
        }

        /* --- Scrollable --- */
        .scroll-area {
            max-height: 340px;
            overflow-y: auto;
            padding-right: 4px;
        }

        .scroll-area::-webkit-scrollbar {
            width: 3px;
        }

        .scroll-area::-webkit-scrollbar-track {
            background: transparent;
        }

        .scroll-area::-webkit-scrollbar-thumb {
            background: rgba(245, 200, 66, 0.2);
            border-radius: 100px;
        }

        /* --- Misc --- */
        .section-title {
            font-size: 16px;
            font-weight: 700;
            margin: 16px 0 8px;
        }

        .flex-between {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .mt-8 { margin-top: 8px; }
        .mt-12 { margin-top: 12px; }
        .mb-8 { margin-bottom: 8px; }
        .text-center { text-align: center; }
        .text-muted { color: #6c758f; font-size: 13px; }

        /* --- Toast --- */
        .toast {
            position: fixed;
            bottom: 30px;
            left: 50%;
            transform: translateX(-50%);
            background: #1a1e2b;
            padding: 12px 24px;
            border-radius: 100px;
            font-size: 14px;
            font-weight: 500;
            border: 1px solid rgba(245, 200, 66, 0.1);
            box-shadow: 0 12px 40px rgba(0, 0, 0, 0.6);
            display: none;
            z-index: 999;
            color: #e8edf5;
        }

        .toast.show {
            display: block;
            animation: fadeUp 0.25s ease;
        }

        /* responsive */
        @media (max-width: 480px) {
            .app { padding: 16px; }
        }
    </style>
</head>
